<Window x:Class="LocalShelfUploader.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LocalShelf · 手动上传" Width="1040" Height="780" MinWidth="820" MinHeight="650" Background="#10161C" Foreground="#F1F4F6" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,22"><TextBlock Text="LocalShelf   /   手动上传" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="你的独立手动书库 · 不改动 EhViewer 同步漫画或排序" Foreground="#A8B8C4" Margin="0,8,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="#182129" CornerRadius="12" Padding="18" Margin="0,0,0,18"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="NAS 阅读地址（端口通常为 8089）" Margin="0,0,0,8"/><TextBox x:Name="AddressBox" AutomationProperties.Name="NAS 阅读地址"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="NAS 阅读密码 · 不保存" Margin="0,0,0,8"/><PasswordBox x:Name="PasswordBox" Padding="10" Background="#1C252C" Foreground="#F1F4F6" BorderBrush="#46515A" AutomationProperties.Name="NAS 阅读密码"/></StackPanel>
   <Button x:Name="ConnectButton" Grid.Column="2" Content="连接 NAS" VerticalAlignment="Bottom" Click="Connect" Background="{StaticResource Accent}" Foreground="#102323"/>
  </Grid></Border>
  <StackPanel Grid.Row="2" Margin="0,0,0,14"><WrapPanel>
   <Button x:Name="AddButton" Content="＋ 选择漫画文件夹" Click="AddFolders"/>
   <Button x:Name="BatchButton" Content="选择总文件夹（批量）" Click="AddParent"/>
   <Button x:Name="RemoveButton" Content="移出列表" Click="Remove"/>
   <Button x:Name="ClearButton" Content="清空已完成" Click="ClearCompleted"/>
   <Button x:Name="PendingButton" Content="未完成上传…" Click="ManagePending"/>
   <Button x:Name="PreviewButton" Content="查看图片顺序" Click="PreviewOrder"/>
  </WrapPanel><TextBlock Text="也可以拖入文件夹。每本一个目录；图片按 Windows 修改日期从早到晚排列，同时间按文件名自然排序。暂不支持压缩包和多层图片目录。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#A8B8C4"/></StackPanel>
  <DataGrid Grid.Row="3" x:Name="Queue" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" Background="#182129" RowBackground="#1C252C" AlternatingRowBackground="#182129" Foreground="#F1F4F6" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3942" RowHeight="42" HeadersVisibility="Column" EnableRowVirtualization="True">
   <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#27343D"/><Setter Property="Foreground" Value="#D9E6EE"/><Setter Property="Padding" Value="10"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.ColumnHeaderStyle>
   <DataGrid.Columns><DataGridTextColumn Header="漫画名称（上传前可修改）" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="图片数" Binding="{Binding Pages}" Width="80" IsReadOnly="True"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="200" IsReadOnly="True"/></DataGrid.Columns>
  </DataGrid>
  <StackPanel Grid.Row="4" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Text="请连接 NAS，再选择需要上传的漫画。" TextWrapping="Wrap" Margin="0,0,0,10"/>
   <ProgressBar x:Name="Progress" Height="7" Maximum="100" Foreground="{StaticResource Accent}" Background="#263239" BorderThickness="0"/>
   <DockPanel Margin="0,16,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PauseButton" Content="暂停" Click="Pause" IsEnabled="False"/><Button x:Name="UploadButton" Content="开始 / 继续上传" Click="Upload" IsEnabled="False" Background="{StaticResource Accent}" Foreground="#102323"/></StackPanel><TextBlock Text="只上传所选漫画 · 完整校验后发布 · 已确认图片可续传" Foreground="#A8B8C4" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
