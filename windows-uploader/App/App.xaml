<Application x:Class="LocalShelfUploader.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#69CCBC"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#263239"/><Setter Property="Foreground" Value="#F1F4F6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Background" Value="#1C252C"/><Setter Property="Foreground" Value="#F1F4F6"/><Setter Property="BorderBrush" Value="#46515A"/><Setter Property="CaretBrush" Value="#69CCBC"/></Style>
 </Application.Resources>
</Application>
